# Fujifilm Stock Monitor 配置
#
# 请保持温和的检查频率。默认每小时检查一次，并额外随机延迟 0-10 分钟。
INTERVAL_SECONDS=3600
JITTER_SECONDS=600

# 连续失败 N 次后发送失效报警。之后每多失败 N 次重复报警。
FAILURE_ALERT_AFTER=3
FAILURE_ALERT_REPEAT=24

# 可选推送渠道。留空表示禁用。
SERVERCHAN_SENDKEY=
STOCK_NTFY_TOPIC=
STOCK_WEBHOOK_URL=

# Web 后台通行密钥哈希和会话签名密钥。install.sh 会自动生成。
FUJIFILM_ADMIN_KEY_HASH=
FUJIFILM_SESSION_SECRET=
FUJIFILM_COOKIE_SECURE=

# 可选监控配置。
# 如果 CONFIG_FILE 指向存在的 JSON 配置，服务会优先使用多任务配置。
# CONFIG_FILE=/home/ubuntu/.config/fujifilm-stock-monitor/config.json
#
# 使用默认页面时，REQUIRE_TEXT 建议保持不变。
# URL=https://mall-jp.fujifilm.com/shop/c/c306010/
# REQUIRE_TEXT=チェキ用フィルム

# 可选停止/去重策略：
# 第一次补货推送后永久停止：
# STOP_MARKER=/home/ubuntu/.config/fujifilm-stock-monitor/stopped.json
#
# 每款商品每个自然月最多推送一次：
# MONTHLY_MARKER_DIR=/home/ubuntu/.config/fujifilm-stock-monitor/monthly

# Fujifilm Stock Monitor config
#
# Keep intervals gentle. The defaults check once per hour plus 0-10 minutes random jitter.
INTERVAL_SECONDS=3600
JITTER_SECONDS=600

# Notify after N consecutive failed checks. Repeat every N additional failed checks.
FAILURE_ALERT_AFTER=3
FAILURE_ALERT_REPEAT=24

# Optional notifications. Leave blank to disable.
SERVERCHAN_SENDKEY=
STOCK_NTFY_TOPIC=
STOCK_WEBHOOK_URL=

# Optional monitor customization.
# For the default page, REQUIRE_TEXT should remain unchanged.
# URL=https://mall-jp.fujifilm.com/shop/c/c306010/
# REQUIRE_TEXT=チェキ用フィルム
